{
  "manifest_version": 3,
  "name": "Video Tuner",
  "version": "1.0.0",
  "description": "Controle o volume (ate 600%) e a velocidade dos videos de qualquer site.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Video Tuner - configuracao"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "speed-up": {
      "suggested_key": { "default": "Ctrl+Shift+Period" },
      "description": "Aumentar velocidade"
    },
    "speed-down": {
      "suggested_key": { "default": "Ctrl+Shift+Comma" },
      "description": "Diminuir velocidade"
    },
    "speed-reset": {
      "suggested_key": { "default": "Ctrl+Shift+0" },
      "description": "Resetar velocidade"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
